# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data store (portfolios, trades, watch lists)
/data

# tests
/test-results
/.next-test
/playwright-report

# git history bundles of each release (git clone releases/stock-tool-vX.Y.Z.bundle)
/releases

# Power BI Desktop local state (the report itself is committed as a .pbip project)
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/editorSettings.json
analytics/powerbi/**/TMDLScripts/
