table _Measures
	lineageTag: 9e2c8d62-f609-4106-aac7-cc9c000df7b0

	measure 'Holdings TWR' =
			// Time-weighted return of the holdings over the selected dates. Format as %.
			VAR Growth = PRODUCTX ( fact_daily_portfolio, fact_daily_portfolio[growth_factor] )
			RETURN IF ( ISBLANK ( Growth ), BLANK (), Growth - 1 )
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: a8dac1f3-c272-4772-8472-f275d4fa5fad

	measure 'Period P&L' =
			SUMX (
			    fact_daily_portfolio,
			    fact_daily_portfolio[value_close_aud] + fact_daily_portfolio[sales_aud] + fact_daily_portfolio[income_aud]
			        - fact_daily_portfolio[value_open_aud] - fact_daily_portfolio[purchases_aud]
			)
		formatString: #,0.00
		displayFolder: Returns
		lineageTag: 0eabd064-fba7-42a7-ae27-cc26d3f1207e

	measure Contribution =
			// Per-holding P&L (price moves, trades and that holding's dividends and fees). Sums to Period P&L.
			SUM ( fact_daily_holdings[pnl_aud] )
		formatString: #,0.00
		displayFolder: Returns
		lineageTag: 71d462ae-5fdd-467c-baca-babe0b4df33e

	measure 'Contribution Share' = DIVIDE ( [Contribution], CALCULATE ( [Contribution], REMOVEFILTERS ( dim_security ) ) )
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: b8b91990-3be8-4455-9269-0123eddb3730

	measure 'Benchmark Return' =
			// Needs exactly one benchmark selected (slicer on fact_benchmark[benchmark]).
			// Base = the benchmark's close on the last trading day before the period, as in the app.
			VAR FirstDay = MIN ( fact_daily_portfolio[date] )
			VAR LastDay = MAX ( fact_daily_portfolio[date] )
			VAR BaseDay =
			    CALCULATE ( MAX ( fact_benchmark[date] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_benchmark[date] < FirstDay )
			VAR BaseClose =
			    CALCULATE ( MAX ( fact_benchmark[close_aud] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_benchmark[date] = BaseDay )
			VAR LastClose =
			    CALCULATE ( MAX ( fact_benchmark[close_aud] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_benchmark[date] = LastDay )
			RETURN IF ( HASONEVALUE ( fact_benchmark[benchmark] ), DIVIDE ( LastClose, BaseClose ) - 1 )
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: 76de540c-9ec4-4a10-ad49-3c5527c38884

	measure 'Excess Return' = [Holdings TWR] - [Benchmark Return]
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: b20fe62a-9301-4cf5-ba46-71e27a274966

	measure 'Account TWR' =
			VAR Growth = PRODUCTX ( fact_daily_account, fact_daily_account[account_factor] )
			RETURN IF ( ISBLANK ( Growth ), BLANK (), Growth - 1 )
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: fd999dab-00f4-41f6-a97a-9fde97688fd0

	measure 'Account XIRR' =
			// Money-weighted return, annualised. Investor cash flows: the account value at the start of the period
			// (money "put in"), deposits as negatives, withdrawals as positives, and the closing value.
			VAR FirstDay = MIN ( fact_daily_account[date] )
			VAR LastDay = MAX ( fact_daily_account[date] )
			VAR Opening = CALCULATE ( SUM ( fact_daily_account[account_open_aud] ), fact_daily_account[date] = FirstDay )
			VAR Closing = CALCULATE ( SUM ( fact_daily_account[account_close_aud] ), fact_daily_account[date] = LastDay )
			VAR Flows =
			    UNION (
			        ROW ( "Day", FirstDay, "Amount", - Opening ),
			        SELECTCOLUMNS (
			            FILTER ( fact_daily_account, fact_daily_account[external_flow_aud] <> 0 ),
			            "Day", fact_daily_account[date],
			            "Amount", - fact_daily_account[external_flow_aud]
			        ),
			        ROW ( "Day", LastDay, "Amount", Closing )
			    )
			RETURN XIRR ( Flows, [Amount], [Day] )
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: 07ff4fd8-b385-48b5-a987-bfbdf0064e1b

	measure 'Base Index' =
			// cum_index on the day before the selected period starts (1 if it starts with the first trade).
			VAR FirstDay = CALCULATE ( MIN ( fact_daily_portfolio[date] ), ALLSELECTED ( dim_date ) )
			VAR FirstRow = CALCULATE ( MAX ( fact_daily_portfolio[cum_index] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_daily_portfolio[date] = FirstDay )
			VAR FirstFactor = CALCULATE ( MAX ( fact_daily_portfolio[growth_factor] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_daily_portfolio[date] = FirstDay )
			RETURN DIVIDE ( FirstRow, FirstFactor )
		formatString: 0.0000
		displayFolder: Charts
		lineageTag: 0a129199-2e01-44b8-8a4b-2861b74c0c42

	measure 'Cumulative Return' =
			// Value on the last trading day in context, so it works per day or per month on the axis.
			VAR LastDay = MAX ( fact_daily_portfolio[date] )
			VAR Today = CALCULATE ( MAX ( fact_daily_portfolio[cum_index] ), fact_daily_portfolio[date] = LastDay )
			RETURN IF ( NOT ISBLANK ( Today ), Today / [Base Index] - 1 )
		formatString: 0.00%
		displayFolder: Charts
		lineageTag: b6ef6be0-608f-4520-8d9f-e7f8a65ce597

	measure 'Cumulative Benchmark' =
			VAR ThisDay = MAX ( fact_daily_portfolio[date] )
			VAR FirstDay = CALCULATE ( MIN ( fact_daily_portfolio[date] ), ALLSELECTED ( dim_date ) )
			VAR BaseDay = CALCULATE ( MAX ( fact_benchmark[date] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_benchmark[date] < FirstDay )
			VAR BaseClose = CALCULATE ( MAX ( fact_benchmark[close_aud] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_benchmark[date] = BaseDay )
			VAR TodayClose = CALCULATE ( MAX ( fact_benchmark[close_aud] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_benchmark[date] = ThisDay )
			RETURN IF ( NOT ISBLANK ( ThisDay ) && HASONEVALUE ( fact_benchmark[benchmark] ), DIVIDE ( TodayClose, BaseClose ) - 1 )
		formatString: 0.00%
		displayFolder: Charts
		lineageTag: aea962fa-79e7-4939-b9c7-fa52a237e211

	measure Drawdown =
			// Fall from the highest point so far in the selected period (the period start counts as a peak).
			VAR ThisDay = MAX ( fact_daily_portfolio[date] )
			VAR Today = MAX ( fact_daily_portfolio[cum_index] )
			VAR Peak =
			    MAX (
			        [Base Index],
			        CALCULATE ( MAX ( fact_daily_portfolio[cum_index] ), ALLSELECTED ( dim_date ), fact_daily_portfolio[date] <= ThisDay )
			    )
			RETURN IF ( NOT ISBLANK ( Today ), Today / Peak - 1 )
		formatString: 0.00%
		displayFolder: Charts
		lineageTag: 8ba46392-2b8a-4d64-b481-9f094bc6232b

	measure 'Max Drawdown' =
			VAR Days =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( fact_daily_portfolio[date] ) ),
			        "@Index", CALCULATE ( MAX ( fact_daily_portfolio[cum_index] ) )
			    )
			VAR BaseIndex = [Base Index]
			VAR WithPeak =
			    ADDCOLUMNS (
			        Days,
			        "@Peak",
			            VAR ThisDay = fact_daily_portfolio[date]
			            RETURN MAX ( BaseIndex, MAXX ( FILTER ( Days, fact_daily_portfolio[date] <= ThisDay ), [@Index] ) )
			    )
			RETURN MIN ( 0, MINX ( WithPeak, [@Index] / [@Peak] - 1 ) )
		formatString: 0.00%
		displayFolder: Charts
		lineageTag: 5bb8cb7d-a2a7-41a4-a7c1-2421ae14b672

	measure 'Market Value' =
			// Value at the last trading day of the selection.
			VAR LastDay = MAX ( fact_daily_portfolio[date] )
			RETURN CALCULATE ( SUM ( fact_daily_holdings[value_close_aud] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_financial_year ), fact_daily_holdings[date] = LastDay )
		formatString: #,0.00
		displayFolder: Holdings
		lineageTag: bb96b9e5-3a64-4f41-a199-ccd425a3204c

	measure Weight = DIVIDE ( [Market Value], CALCULATE ( [Market Value], REMOVEFILTERS ( dim_security ) ) )
		formatString: 0.00%
		displayFolder: Holdings
		lineageTag: e66e3f14-4700-4249-b3e1-7573938ae3bf

	measure 'Cash Balance' =
			VAR LastDay = MAX ( fact_daily_account[date] )
			RETURN CALCULATE ( SUM ( fact_daily_account[cash_aud] ), fact_daily_account[date] = LastDay )
		formatString: #,0.00
		displayFolder: Holdings
		lineageTag: 8912d60a-34b8-4881-982d-be73b3beff7e

	measure 'Account Value' =
			VAR LastDay = MAX ( fact_daily_account[date] )
			RETURN CALCULATE ( SUM ( fact_daily_account[account_close_aud] ), fact_daily_account[date] = LastDay )
		formatString: #,0.00
		displayFolder: Holdings
		lineageTag: 463afb37-fd8b-4b29-ac81-384fefc9a772

	measure 'Net Contributions' = SUM ( fact_daily_account[external_flow_aud] )
		formatString: #,0.00
		displayFolder: Holdings
		lineageTag: cc2d987b-caa0-4f0d-b8ae-71c56685940e

	measure 'Closed Trades' = COUNTROWS ( fact_closed_trades )
		formatString: 0
		displayFolder: Trading
		lineageTag: e250862e-d1a3-4c23-94ac-97867e6afa3c

	measure 'Realised P&L' = SUM ( fact_closed_trades[pnl_aud] )
		formatString: #,0.00
		displayFolder: Trading
		lineageTag: 73845034-a6d4-4cd8-ae8a-6ba6bf179764

	measure 'Win Rate' = DIVIDE ( COUNTROWS ( FILTER ( fact_closed_trades, fact_closed_trades[pnl_aud] > 0 ) ), [Closed Trades] )
		formatString: 0.00%
		displayFolder: Trading
		lineageTag: 43fa635d-a7b7-4893-9390-93329062741f

	measure 'Profit Factor' =
			VAR Wins = CALCULATE ( SUM ( fact_closed_trades[pnl_aud] ), fact_closed_trades[pnl_aud] > 0 )
			VAR Losses = - CALCULATE ( SUM ( fact_closed_trades[pnl_aud] ), fact_closed_trades[pnl_aud] < 0 )
			RETURN DIVIDE ( Wins, Losses )
		formatString: 0.00
		displayFolder: Trading
		lineageTag: 11501bac-5535-4593-92ea-5dd972454311

	measure 'Average Holding Days' = AVERAGE ( fact_closed_trades[holding_days] )
		formatString: 0.0
		displayFolder: Trading
		lineageTag: f731b5a9-5fb0-431c-b762-04ce81b9add7

	measure 'Tag P&L' =
			// Realised P&L split by the strategy tags of the parcels each sale closed (bridge_closed_trade_tag).
			SUM ( bridge_closed_trade_tag[pnl_aud] )
		formatString: #,0.00
		displayFolder: Trading
		lineageTag: d6d97528-30ae-4b87-b70e-0d8dcd663526

	measure 'Gross Capital Gains (18H)' = CALCULATE ( SUM ( fact_cgt_events[gain_aud] ), fact_cgt_events[gain_aud] > 0 )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: c5c9dc3a-fbed-48de-aa9b-81c8a4442dff

	measure 'Capital Losses This Year' = - CALCULATE ( SUM ( fact_cgt_events[gain_aud] ), fact_cgt_events[gain_aud] < 0 )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 003b20b6-dd93-47e1-bcdd-31c01e48ca06

	measure 'Discount-Eligible Gains' = CALCULATE ( SUM ( fact_cgt_events[gain_aud] ), fact_cgt_events[gain_aud] > 0, fact_cgt_events[discount_eligible] = 1 )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: f9c35969-206e-47ec-9ce6-0424573093f1

	measure 'Net Capital Gain (18A)' = SUM ( fact_tax_year[label_18A] )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 9bba8591-f787-43d0-9d1a-1b02d49f376a

	measure 'Losses Carried Forward (18V)' = SUM ( fact_tax_year[label_18V] )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 9f50fdde-e572-4cca-a95b-26e4120c40d9

	measure 'CGT Discount Applied' = SUM ( fact_tax_year[discount] )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 37739c10-6798-4156-8388-a72bd15608cf

	measure 'Franked Dividends (11T)' = SUM ( fact_dividends[franked_aud] )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: f8b55c7a-9949-48d2-b774-f2c042b58961

	measure 'Unfranked Dividends (11S)' = CALCULATE ( SUM ( fact_dividends[unfranked_aud] ), fact_dividends[type] = "Australian" )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 8bf55c3a-14dc-4ea4-961a-e6a9dadd72e0

	measure 'Franking Credits (11U)' = SUM ( fact_dividends[franking_credit_aud] )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: c44b6fb5-4f77-44a9-a41a-5c153de59605

	measure 'Foreign Income (20E)' = CALCULATE ( SUM ( fact_dividends[assessable_aud] ), fact_dividends[type] = "Foreign" )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 3dfb5111-128d-4106-ad25-03a6879430b4

	measure 'Foreign Tax Offset (20O)' = CALCULATE ( SUM ( fact_dividends[withheld_aud] ), fact_dividends[type] = "Foreign" )
		formatString: #,0.00
		displayFolder: Tax
		lineageTag: 338da088-e6c9-4269-bca3-6c4f0d01510f

	measure 'Worst Drawdown' =
			// Deepest daily drawdown inside the current axis bucket (e.g. a month).
			MINX ( VALUES ( fact_daily_portfolio[date] ), [Drawdown] )
		formatString: 0.00%
		displayFolder: Charts
		lineageTag: 2db44842-7c85-4960-8671-81051d854a7e

	column Value
		isHidden
		lineageTag: 2ef57887-aafe-4eb5-bffb-06542232f707
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = ROW("Value", 0)

