LoadCsv("fact_trades", {{"trade_id", type text}, {"date", type date}, {"symbol", type text}, {"side", type text}, {"quantity", type number}, {"price_local", type number}, {"fx_to_aud", type number}, {"value_aud", type number}, {"brokerage_aud", type number}})

