// Generated by npm run bi:export. Do not edit by hand.
// Each "===== Query:" block is one query in Power BI (Home → Transform data → New source → Blank query →
// Advanced editor, paste the block, then rename the query to the name after "Query:").
// Create the two helper queries first, in this order.

// ===== Parameter: DataFolder
// Home → Manage parameters → New: name DataFolder, type Text, value = full path of analytics\data, e.g.
// C:\Users\you\stock-tool\analytics\data

// ===== Query: LoadCsv
// CSVs are UTF-8 with "." decimals and ISO dates, so types are applied with the en-US culture
// whatever the regional settings of the PC opening the report.
(name as text, types as list) as table =>
let
    Source = Csv.Document(File.Contents(DataFolder & "\" & name & ".csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Promoted, types, "en-US")
in
    Typed

// ===== Query: dim_date
LoadCsv("dim_date", {{"date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"fy", Int64.Type}, {"fy_label", type text}, {"fy_quarter", type text}, {"is_trading_day", Int64.Type}})

// ===== Query: dim_financial_year
LoadCsv("dim_financial_year", {{"fy", Int64.Type}, {"fy_label", type text}, {"start_date", type date}, {"end_date", type date}})

// ===== Query: dim_security
LoadCsv("dim_security", {{"symbol", type text}, {"name", type text}, {"sector", type text}, {"market", type text}, {"currency", type text}, {"is_benchmark", Int64.Type}})

// ===== Query: fact_prices
LoadCsv("fact_prices", {{"date", type date}, {"symbol", type text}, {"close_local", type number}, {"fx_to_aud", type number}, {"close_aud", type number}})

// ===== Query: fact_benchmark
LoadCsv("fact_benchmark", {{"date", type date}, {"benchmark", type text}, {"close_aud", type number}})

