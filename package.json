{
  "name": "stock-tool",
  "version": "1.3.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test -c playwright.config.ts",
    "check": "npm run lint && npx tsc --noEmit -p tsconfig.test.json && npm test",
    "build:test": "node -e \"process.env.NEXT_DIST_DIR='.next-test'; require('child_process').execSync('npx next build', { stdio: 'inherit', env: process.env })\"",
    "test:e2e": "playwright test -c playwright.qa.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:all": "node scripts/run-tests.mjs",
    "test:full": "node scripts/run-tests.mjs --live",
    "test:quick": "node scripts/run-tests.mjs --quick"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "d3-hierarchy": "^3.1.2",
    "lightweight-charts": "^5.2.0",
    "next": "^16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "undici": "^7.30.1"
  }
}
